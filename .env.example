# =====================================================================
#  ไฟล์ตั้งค่าระบบบริหารจัดการสมาชิก วิทยาลัยเทคนิคมีนบุรี
#  - คัดลอกไฟล์นี้เป็น .env แล้วแก้ค่า (ถ้าไม่มี .env ระบบจะสร้างให้อัตโนมัติ)
#  - ห้ามนำไฟล์ .env ขึ้น Git หรือส่งต่อ เพราะมีรหัสลับของระบบ
#  - แก้แล้วต้องรีสตาร์ตเซิร์ฟเวอร์ (ปิดแล้วรัน python app.py ใหม่)
# =====================================================================

# ---- ความปลอดภัย ------------------------------------------------------
# กุญแจสำหรับเซ็น token เข้าสู่ระบบ — ต้องเป็นค่าสุ่มยาวๆ และเก็บเป็นความลับ
# สร้างใหม่ได้ด้วยคำสั่ง: python -c "import secrets; print(secrets.token_hex(32))"
# (ถ้าเปลี่ยนค่านี้ ผู้ใช้ทุกคนต้อง login ใหม่)
SECRET_KEY=

# อายุการเข้าสู่ระบบ (ชั่วโมง) ก่อนต้อง login ใหม่
JWT_EXPIRES_HOURS=8

# ---- ฐานข้อมูล ----------------------------------------------------------
# SQLite (ค่าเริ่มต้น) — path สัมพัทธ์นับจากโฟลเดอร์หลักของโปรเจกต์
DATABASE_URL=sqlite:///database/app.db
# PostgreSQL (ต้อง pip install psycopg2-binary)
# DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/managemember
# MySQL (ต้อง pip install PyMySQL)
# DATABASE_URL=mysql+pymysql://user:password@localhost:3306/managemember?charset=utf8mb4

# ---- เซิร์ฟเวอร์ --------------------------------------------------------
# 127.0.0.1 = ใช้ได้เฉพาะเครื่องนี้ | 0.0.0.0 = เครื่องอื่นในเครือข่ายเข้าได้
HOST=127.0.0.1
PORT=5000
# 1 = โหมดพัฒนา (แสดงรายละเอียด error, รีโหลดเมื่อแก้โค้ด) | 0 = ใช้งานจริง
FLASK_DEBUG=0
# โดเมนที่อนุญาตให้เรียก API (กรณีเปิด frontend แยกพอร์ต) คั่นหลายค่าด้วย ,
# เช่น http://127.0.0.1:5500,http://localhost:5500   หรือ * = อนุญาตทั้งหมด
CORS_ORIGINS=*

# ---- ไฟล์ ---------------------------------------------------------------
# โฟลเดอร์เก็บรูปภาพ และไฟล์สำรองฐานข้อมูล (path สัมพัทธ์นับจากโฟลเดอร์หลัก)
UPLOAD_FOLDER=backend/uploads
BACKUP_FOLDER=database/backups
# ขนาดรูปสูงสุดต่อไฟล์ และขนาดรวมต่อการบันทึก 1 ครั้ง (MB)
MAX_UPLOAD_MB=5
MAX_REQUEST_MB=20

# ---- ข้อมูลองค์กร -------------------------------------------------------
# ชื่อที่แสดงบนหัวรายงาน Excel / PDF
ORG_NAME=องค์การนักวิชาชีพในอนาคตแห่งประเทศไทย วิทยาลัยเทคนิคมีนบุรี
# ชื่อที่ใช้ในเอกสารแบบ อวท.08 / อวท.09 / อวท.10
AVT_NAME=องค์การนักวิชาชีพในอนาคตแห่งประเทศไทย
COLLEGE_NAME=วิทยาลัยเทคนิคมีนบุรี
# ตรา อวท. บนหัวเอกสาร (ไฟล์ PNG/JPG) — ถ้าไม่มีไฟล์จะเว้นที่ว่างไว้
AVT_LOGO=backend/data/avt_logo.png
